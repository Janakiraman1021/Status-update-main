# --- Core ---------------------------------------------------------------
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_SECRET=

# --- MongoDB ------------------------------------------------------------
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://localhost:27017
# Offline demo (in-memory, data lost on restart): mongomock://
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=worklog

# --- Login (single user) --------------------------------------------------
# The only account that can sign in. Created on startup and updated when these change
# (restart the backend after editing). Only a bcrypt hash of the password is stored in MongoDB.
APP_USER_NAME=Janakiraman K
APP_USER_EMAIL="janakiraman.k@samunnati.com"
APP_USER_PASSWORD=Janakiraman@21

# --- Sessions -----------------------------------------------------------
SESSION_TTL_HOURS=0
REMEMBER_TTL_DAYS=30
# Defaults to true when FLASK_ENV=production. Requires HTTPS.
COOKIE_SECURE=
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Failed logins allowed per window; set to 0 to disable login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- AI -----------------------------------------------------------------
# local = offline rule-based formatter (no API key, never adds information)
# groq  = open models hosted on Groq (get a key at https://console.groq.com/keys)
AI_PROVIDER=local
AI_API_KEY=
# Groq model id. Qwen on Groq: qwen/qwen3.8-27b (default). Smaller/faster: llama-3.1-8b-instant
AI_MODEL=qwen/qwen3.8-27b
# Leave empty for https://api.groq.com/openai/v1
AI_BASE_URL=
# Qwen thinking effort: none (fastest), default, low, medium, high
AI_REASONING_EFFORT=none
AI_TIMEOUT_SECONDS=120

# --- Email --------------------------------------------------------------
# outlook = send through Outlook (classic) on this Windows PC (no SMTP login needed; appears in Sent Items)
# smtp    = real delivery through an SMTP server
# console = development; writes .eml files to OUTBOX_DIR
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=WorkLog
# EOD email branding. Colours are #RRGGBB. The logo comes from EMAIL_BRAND_LOGO_PATH (embedded in the email)
# or EMAIL_BRAND_LOGO_URL (public https:// image); with neither, the company name is shown as text.
EMAIL_BRAND_NAME=Samunnati
EMAIL_BRAND_PRIMARY=#0B6B3A
EMAIL_BRAND_ACCENT=#F2A900
EMAIL_BRAND_SOFT=#EEF6F1
EMAIL_BRAND_LEGAL_NAME=Samunnati Finance Private Limited
# Logo file embedded in every EOD email (PNG/JPG/GIF, under 1 MB, ideally about 340 px wide on a transparent or white background)
EMAIL_BRAND_LOGO_PATH=assets/brand-logo.png
EMAIL_BRAND_WEBSITE=
EMAIL_BRAND_LOGO_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
OUTBOX_DIR=outbox

# --- Scheduling -----------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
EOD_DEFAULT_TIME=18:30
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
EOD_MAX_AUTO_ATTEMPTS=3
EOD_AUTO_RETRY_MINUTES=10

# --- Frontend / logging -------------------------------------------------
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
